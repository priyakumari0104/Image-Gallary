<body>
  <div class="container">
    <form class="form" method="post" action="/create">
    <input class="tittle" type="text" placeholder="task tittle" name="title"/>
    <textarea class="textarea" type=" text" placeholder="describe your task" name="details"></textarea>
    <button  type="submit" class=" submit">create task</button>
    </form>
<div class="tasks">
<div class="tasks">

<% if(files.length > 0){ %>

    <% files.forEach(function(val){ %>

        <div class="cards ">
        <h2 class="card-tittle">task 1</h2>
        <p class="card-description"><%= val %></p>
        <a href="/files/<%= val %>" class="card-link">view details</a>
        <a href="/edit/<%= val %>" class="card-link">edit</a>
    </div>
<div class="cards hidden">
        <h2 class="card-tittle">task 2</h2>
        <p class="card-description"><%= val %></p>
        <a href="/files/<%= val %>" class="card-link">view details</a>
        <a href="/edit/<%= val %>" class="card-link">edit</a>
    </div>
    <% }) %>

<% } else { %>

    <h1>No Task Yet</h1>

<% } %>

</div>
